{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Suggestions" %}
{% set selectedSubnavItem = "suggestions" %}

{% set actionUrl = 'synthese-engine/cp/suggestion-action' %}

{% block content %}

    {# De privacykeuze staat hier en niet op het instellingenscherm: plugin-settings
       zijn project config, en die wordt bij een deploy teruggezet. Deze drie staan
       in de database, zodat de keuze van de beheerder blijft staan. #}
    <div class="pane" style="margin-bottom:24px;">
        <h2>Where suggestions come from</h2>
        <p class="light">
            The search page can offer visitors questions to click. Collecting means the text
            of a question a visitor typed is stored as a candidate. Even then nothing reaches
            the site until you approve it below.
        </p>

        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('synthese-engine/cp/save-suggestion-settings') }}
            {{ redirectInput('synthese-engine/suggestions?status=' ~ status) }}

            {{ forms.selectField({
                label: 'Suggestions',
                name: 'mode',
                options: modeOptions,
                value: mode,
            }) }}

            {{ forms.textField({
                label: 'Different visitors before a question is offered for approval',
                name: 'minAskers',
                type: 'number',
                min: 1,
                value: minAskers,
                instructions: 'Higher means fewer, more common questions, and less chance of one
                    person\'s wording ending up on the site.',
            }) }}

            {{ forms.textField({
                label: 'Days to keep search queries',
                name: 'retentionDays',
                type: 'number',
                min: 0,
                value: retentionDays,
                instructions: 'The log table holds the text of every question asked next to a
                    hashed IP address. Older rows are deleted by
                    synthese-engine/suggestions/prune. 0 keeps everything, which is rarely what
                    you want.',
            }) }}

            <button type="submit" class="btn submit">Save</button>
        </form>
    </div>

    {% if mode != 'moderated' %}
        <div class="pane" style="margin-bottom:24px;">
            <p class="warning">
                {% if mode == 'off' %}
                    Suggestions are switched off. The search page shows the fixed example
                    questions from the config file, and questions visitors ask are not
                    collected.
                {% else %}
                    Only questions added by hand are used. Questions visitors ask are not
                    collected, and anything harvested earlier is no longer shown, even if it
                    was approved at the time.
                {% endif %}
                Change this under
                <a href="{{ url('settings/plugins/synthese-engine') }}">Settings</a>.
            </p>

            {% if harvestedCount > 0 %}
                <p>
                    There {{ harvestedCount == 1 ? 'is' : 'are' }} still <strong>{{ harvestedCount }}</strong>
                    question{{ harvestedCount == 1 ? '' : 's' }} on file that came from visitors.
                    They are not shown anywhere, but they are still stored.
                </p>
                <form method="post" accept-charset="UTF-8">
                    {{ csrfInput() }}
                    {{ actionInput(actionUrl) }}
                    {{ redirectInput('synthese-engine/suggestions?status=' ~ status) }}
                    {{ hiddenInput('op', 'forget') }}
                    <button type="submit" class="btn delete"
                            data-confirm="Delete all {{ harvestedCount }} questions that came from visitors? Questions you added yourself are kept. This cannot be undone.">
                        Delete the {{ harvestedCount }} collected question{{ harvestedCount == 1 ? '' : 's' }}
                    </button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    <div class="pane" style="margin-bottom:24px;">
        <p>
            {% if mode == 'moderated' %}
                Questions visitors asked, grouped by meaning. Nothing here reaches the site until
                you approve it. A question only enters the queue once
                <strong>{{ minAskers }}</strong> different visitors asked it and
                it produced an answer with sources.
            {% else %}
                Questions you add here yourself. Collecting questions from visitors is switched
                off, so the queue stays empty.
            {% endif %}
        </p>

        <form method="post" accept-charset="UTF-8" style="margin-top:16px;">
            {{ csrfInput() }}
            {{ actionInput(actionUrl) }}
            {{ redirectInput('synthese-engine/suggestions?status=approved') }}
            {{ hiddenInput('op', 'add') }}
            <div class="flex">
                <div class="flex-grow">
                    {{ forms.text({
                        name: 'question',
                        placeholder: 'Add a question yourself, for instance to fill the chips before there is traffic',
                        maxlength: 500,
                    }) }}
                </div>
                <div><button type="submit" class="btn submit">Add and approve</button></div>
            </div>
        </form>
    </div>

    <div class="flex" style="margin-bottom:16px;align-items:center;gap:8px;">
        {% for tab, label in { pending: 'Queue', approved: 'Approved', rejected: 'Rejected' } %}
            <a class="btn{{ status == tab ? ' active' : '' }}"
               href="{{ url('synthese-engine/suggestions', { status: tab }) }}">
                {{ label }}{% if tab == 'pending' and pendingCount %} ({{ pendingCount }}){% endif %}
            </a>
        {% endfor %}

        <div class="flex-grow"></div>

        {% if mode == 'moderated' %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('synthese-engine/cp/harvest') }}
                {{ redirectInput('synthese-engine/suggestions?status=' ~ status) }}
                <button type="submit" class="btn">Harvest now</button>
            </form>
        {% endif %}
    </div>

    {% if rows|length == 0 %}
        <div class="pane">
            <p>
                {% if status == 'pending' %}
                    Nothing waiting. Either no question has been asked by
                    {{ minAskers }} different visitors yet, or everything has
                    been dealt with.
                {% elseif status == 'approved' %}
                    Nothing approved yet, so the chips fall back to the fixed
                    <code>exampleQueries</code> from the config.
                {% else %}
                    Nothing rejected.
                {% endif %}
            </p>
        </div>
    {% else %}
        <table class="data fullwidth collapsible">
            <thead>
                <tr>
                    <th>Question</th>
                    <th class="thin rightalign">Asked</th>
                    <th class="thin rightalign">Visitors</th>
                    <th class="thin">Last asked</th>
                    <th class="thin"></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>
                            <form method="post" accept-charset="UTF-8" class="flex">
                                {{ csrfInput() }}
                                {{ actionInput(actionUrl) }}
                                {{ redirectInput('synthese-engine/suggestions?status=' ~ status) }}
                                {{ hiddenInput('id', row.id) }}
                                {{ hiddenInput('op', 'rewrite') }}
                                <div class="flex-grow">
                                    {{ forms.text({ name: 'question', value: row.question, maxlength: 500 }) }}
                                </div>
                                <div><button type="submit" class="btn small">Save text</button></div>
                            </form>

                            <div class="light smalltext" style="margin-top:4px;">
                                {% if row.origin == 'manual' %}Added by hand{% else %}Harvested{% endif %}
                                {%- if row.edited_by_admin %}, rewritten{% endif %}
                                {%- if row.pinned %}, pinned{% endif %}
                                {%- if row.variants|length > 1 %}
                                    &middot; also asked as:
                                    {% for variant in row.variants|slice(1, 4) %}
                                        &ldquo;{{ variant.query_normalized }}&rdquo;{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                    {%- if row.variants|length > 5 %} and {{ row.variants|length - 5 }} more{% endif %}
                                {% endif %}
                            </div>
                        </td>
                        <td class="thin rightalign">{{ row.ask_count }}</td>
                        <td class="thin rightalign">{{ row.asker_count }}</td>
                        <td class="thin">{{ row.last_asked_at ? row.last_asked_at|date('d-m-Y') : '&mdash;'|raw }}</td>
                        <td class="thin nowrap">
                            {% set buttons = status == 'approved'
                                ? [
                                    { op: row.pinned ? 'unpin' : 'pin', label: row.pinned ? 'Unpin' : 'Pin' },
                                    { op: 'reject', label: 'Reject' },
                                ]
                                : (status == 'rejected'
                                    ? [{ op: 'requeue', label: 'Back to queue' }]
                                    : [
                                        { op: 'approve', label: 'Approve', class: 'submit' },
                                        { op: 'reject', label: 'Reject' },
                                    ]) %}

                            <div class="flex" style="gap:4px;">
                                {% for button in buttons %}
                                    <form method="post" accept-charset="UTF-8">
                                        {{ csrfInput() }}
                                        {{ actionInput(actionUrl) }}
                                        {{ redirectInput('synthese-engine/suggestions?status=' ~ status) }}
                                        {{ hiddenInput('id', row.id) }}
                                        {{ hiddenInput('op', button.op) }}
                                        <button type="submit" class="btn small {{ button.class ?? '' }}">{{ button.label }}</button>
                                    </form>
                                {% endfor %}

                                <form method="post" accept-charset="UTF-8">
                                    {{ csrfInput() }}
                                    {{ actionInput(actionUrl) }}
                                    {{ redirectInput('synthese-engine/suggestions?status=' ~ status) }}
                                    {{ hiddenInput('id', row.id) }}
                                    {{ hiddenInput('op', 'delete') }}
                                    <button type="submit" class="btn small delete"
                                            data-icon="remove" title="Delete"></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

{% endblock %}
